# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Code coverage
.coverage

# Virtual environments
*.venv

# Keys and secrets
.env
*.env
.env.*

# LLM-generated plans (local only)
plans/

# Local computer files
*.DS_Store
.vscode
# Elastic Beanstalk Files
.elasticbeanstalk/*
!.elasticbeanstalk/*.cfg.yml
!.elasticbeanstalk/*.global.yml

# Database dumps. refresh_staging_from_prod.sh writes here, and even with the
# credential tables excluded these are full copies of production business data --
# hundreds of MB that must never reach a public repository.
dumps/
*.sql.gz
