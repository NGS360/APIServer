# Keep Elastic Beanstalk's log streaming working, and put it back when it stops.
#
# WHY THIS EXISTS
#
# web.stdout.log carries the structured access log: the only record of who calls
# which API route, and the evidence every route closure in the RBAC rollout is
# justified by. Production has silently stopped shipping it four times:
#
#   08-10 -> 08-15   ~108 h   never noticed at the time
#   08-17 -> 08-18    ~17 h   found because a verification query came back empty
#   08-23 -> 08-26    ~68 h   dev and staging
#   08-24 -> 08-26    ~33 h   production
#
# Each time the repair was to toggle the StreamLogs option off and on, which makes
# EB regenerate the agent config. Each time it came back.
#
# WHAT ACTUALLY BREAKS
#
# `StreamLogs` is `true` in CloudFormation, in the live option settings, and in
# `get-config optionsettings` on the instance -- and the agent still ships
# nothing. The agent's config directory tells the story:
#
#   working   file_beanstalk.json   {"logs": ...}        7 collect_list entries
#   broken    file_config.json      {"agent","metrics"}  no logs section at all
#
# So something periodically runs the equivalent of `fetch-config` with a
# metrics-only document. fetch-config **replaces the whole directory**, so the log
# configuration is deleted rather than merged away. On the production instance
# that happened at 08-24 12:04:07Z, the same minute ingestion stopped.
#
# That rules out simply dropping a static file in beside EB's: the next
# regeneration wipes the directory, ours included. So this re-asserts instead. A
# systemd timer checks every minute and repairs with `append-config`, which merges.
#
# ALL SEVEN LOG GROUPS, NOT JUST ONE
#
# An earlier version of this file restored only web.stdout.log. Verified on
# staging by breaking it deliberately: the repair worked in 80 seconds, and the
# other six groups EB configures -- eb-engine, eb-hooks, nginx access and error,
# httpd access and error -- stayed dark. Those are what you read when a deploy
# fails, so losing them silently is its own outage. EB's collect_list is
# reproduced in full below, matching its shape exactly (file_path,
# log_group_name, log_stream_name; no other keys).
#
# WHY IT ALSO REMOVES ITS OWN CONFIG AGAIN
#
# Once EB writes a healthy config of its own, ours becomes a duplicate -- and two
# collect_list entries for one file mean the same line is shipped twice. That is
# worse than it sounds: duplicated access-log events would inflate the very
# request counts the route-closure criterion is decided on, so the evidence would
# be wrong rather than merely missing. The script therefore stands down as soon as
# every path it added is covered by somebody else's config.
#
# The log group names are derived from `get-config container -k environment_name`
# rather than hardcoded, because they must match the groups EB itself uses -- a
# different name would leave the ingestion alarms and every saved Insights query
# pointing at an empty group. Nothing environment-specific is committed here.
#
# This does not replace the ingestion alarms. It reduces how often they fire; the
# alarms remain what tells us it has failed anyway.

files:
  "/opt/ngs360/ensure-eb-log-streaming.py":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/usr/bin/env python3
      """Keep EB's CloudWatch log streaming configured. Idempotent; syslogs only
      when it changes something."""
      import json
      import pathlib
      import subprocess
      import sys
      import syslog

      AGENT = pathlib.Path("/opt/aws/amazon-cloudwatch-agent")
      CONFIG_D = AGENT / "etc/amazon-cloudwatch-agent.d"
      CTL = AGENT / "bin/amazon-cloudwatch-agent-ctl"
      OURS = pathlib.Path("/opt/ngs360/eb-log-streaming.json")

      # Generated name -> the source path append-config derived it from. Both are
      # needed: the name to recognise our own config in the directory, the source
      # to hand to remove-config. The second entry is the name the previous
      # version of this script produced, from a dotfile marker; it worked but
      # should not linger.
      OUR_CONFIGS = {
          "file_eb-log-streaming.json": OURS,
          "file_.web-stdout-config.json":
              pathlib.Path("/opt/ngs360/.web-stdout-config.json"),
      }

      # Exactly what EB configures, in EB's order.
      PATHS = [
          "/var/log/eb-engine.log",
          "/var/log/eb-hooks.log",
          "/var/log/nginx/access.log",
          "/var/log/nginx/error.log",
          "/var/log/httpd/access_log",
          "/var/log/httpd/error_log",
          "/var/log/web.stdout.log",
      ]

      def log(msg):
          syslog.openlog("ngs360-ensure-logging")
          syslog.syslog(syslog.LOG_INFO, msg)

      def configured_paths():
          """file_path -> the config files that declare it."""
          found = {}
          for cfg in sorted(CONFIG_D.glob("*.json")):
              try:
                  doc = json.loads(cfg.read_text())
              except (OSError, json.JSONDecodeError):
                  continue
              entries = (doc.get("logs", {}).get("logs_collected", {})
                            .get("files", {}).get("collect_list", []))
              for entry in entries:
                  path = entry.get("file_path")
                  if path:
                      found.setdefault(path, []).append(cfg.name)
          return found

      def ctl(action, config):
          return subprocess.run(
              [str(CTL), "-a", action, "-m", "ec2", "-c", f"file:{config}", "-s"],
              capture_output=True, text=True).returncode == 0

      def main():
          # A new instance may run this before EB installs the agent.
          if not CTL.exists():
              return 0

          found = configured_paths()
          missing = [p for p in PATHS if p not in found]

          if missing:
              env = subprocess.run(
                  ["/opt/elasticbeanstalk/bin/get-config", "container",
                   "-k", "environment_name"],
                  capture_output=True, text=True).stdout.strip()
              if not env:
                  # Better to leave it broken for the ingestion alarm to catch
                  # than to invent a log group name nothing is watching.
                  log("cannot determine environment_name; agent config untouched")
                  return 1

              OURS.parent.mkdir(parents=True, exist_ok=True)
              OURS.write_text(json.dumps({
                  "logs": {"logs_collected": {"files": {"collect_list": [
                      {"file_path": p,
                       "log_group_name": f"/aws/elasticbeanstalk/{env}{p}",
                       "log_stream_name": "{instance_id}"}
                      for p in PATHS
                  ]}}}
              }, indent=2))

              # append-config merges; fetch-config would replace the directory and
              # is what breaks this in the first place.
              if ctl("append-config", OURS):
                  joined = ", ".join(missing)
                  log(f"re-asserted {len(missing)} log path(s) for {env}: {joined}")
                  return 0
              log(f"append-config FAILED for {env}; ingestion alarm should fire")
              return 1

          # Everything is configured. If that is true only because of us, stay.
          # If somebody else now covers every path we added, stand down -- two
          # entries for one file ship every line twice, which corrupts the
          # request counts the rollout is decided on.
          present = set(OUR_CONFIGS) & {c.name for c in CONFIG_D.glob("*.json")}
          if not present:
              return 0

          redundant = all(
              any(name not in OUR_CONFIGS for name in found.get(p, []))
              for p in PATHS
          )
          if not redundant:
              return 0

          # remove-config, not unlink-then-append-config. An earlier version did
          # the latter and re-added the surviving config under a doubled name,
          # leaving the duplicate entries it was trying to remove -- caught by
          # deliberately breaking staging. remove-config deletes the named config
          # and re-translates, which is exactly what is wanted.
          if any(ctl("remove-config", OUR_CONFIGS[name])
                 for name in sorted(present)):
              log("stood down: EB's own config covers every path again")
          return 0

      if __name__ == "__main__":
          sys.exit(main())

  "/etc/systemd/system/ngs360-ensure-logging.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Ensure Elastic Beanstalk logs are streaming to CloudWatch
      After=amazon-cloudwatch-agent.service

      [Service]
      Type=oneshot
      ExecStart=/opt/ngs360/ensure-eb-log-streaming.py

  "/etc/systemd/system/ngs360-ensure-logging.timer":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Periodically ensure Elastic Beanstalk log streaming is configured

      [Timer]
      # Every minute, so a regeneration costs at most a minute of log data rather
      # than the 17 to 108 hours it has cost so far. Measured repair time when
      # broken deliberately on staging: 80 seconds. The healthy path parses a
      # handful of small JSON files and returns.
      OnBootSec=2min
      OnUnitActiveSec=1min
      AccuracySec=15s

      [Install]
      WantedBy=timers.target

commands:
  01_remove_superseded_script:
    # Superseded by ensure-eb-log-streaming.py, which covers all seven log groups.
    command: rm -f /opt/ngs360/ensure-web-stdout-logging.sh
  02_enable_ensure_logging_timer:
    command: |
      systemctl daemon-reload
      systemctl enable --now ngs360-ensure-logging.timer
      # Run once immediately rather than waiting for OnBootSec: a deploy is one of
      # the moments the config gets regenerated.
      /opt/ngs360/ensure-eb-log-streaming.py || true
