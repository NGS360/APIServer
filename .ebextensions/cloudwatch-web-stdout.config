# Keep web.stdout.log streaming to CloudWatch, and put it back when it stops.
#
# WHY THIS EXISTS
#
# web.stdout.log carries the structured access log: the only record of who calls
# which API route, and the evidence every route closure in the RBAC rollout is
# justified by. Production has silently stopped shipping it four times:
#
#   08-10 -> 08-15   ~108 h   never noticed at the time
#   08-17 -> 08-18    ~17 h   found because a verification query came back empty
#   08-23 -> 08-26    ~68 h   dev and staging
#   08-24 -> 08-26    ~33 h   production
#
# Each time the fix was to toggle the StreamLogs option off and on, which makes
# Elastic Beanstalk regenerate the agent config. Each time it came back.
#
# WHAT ACTUALLY BREAKS
#
# `StreamLogs` is `true` in CloudFormation, in the live option settings, and in
# `get-config optionsettings` on the instance -- and the agent still ships
# nothing. The agent's config directory tells the story:
#
#   working   file_beanstalk.json   1481 B   {"logs": ...}      watches the file
#   broken    file_config.json      1026 B   {"agent","metrics"} no logs at all
#
# So something periodically runs the equivalent of `fetch-config` with a
# metrics-only document. `fetch-config` **replaces the whole directory** -- both
# the file name and the directory mtime change together -- so the log
# configuration is not merged away, it is deleted. That is why simply dropping a
# static file in beside it would not survive either: the next regeneration wipes
# the directory, ours included.
#
# Hence a check that re-asserts rather than a file that hopes. The timer notices
# within a minute and repairs it with `append-config`, which merges instead of
# replacing. Cost when healthy is one grep.
#
# The log group name is derived from `get-config container -k environment_name`
# rather than hardcoded: it has to match the group Elastic Beanstalk itself uses,
# or the existing alarms and every saved Insights query would silently look at an
# empty group. Nothing environment-specific is committed here.
#
# This does not replace the ingestion alarms. It reduces how often they fire; the
# alarms remain the thing that tells us when it has failed anyway.

files:
  "/opt/ngs360/ensure-web-stdout-logging.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Ensure the CloudWatch agent is watching web.stdout.log. Idempotent.
      set -uo pipefail

      AGENT_DIR=/opt/aws/amazon-cloudwatch-agent
      CONFIG_D="$AGENT_DIR/etc/amazon-cloudwatch-agent.d"
      WATCHED=/var/log/web.stdout.log
      MARKER=/opt/ngs360/.web-stdout-config.json
      TAG=ngs360-ensure-logging

      log() { logger -t "$TAG" -- "$1"; }

      # Nothing to do while the agent is not installed yet -- during the first
      # minutes of a new instance this script may run before EB installs it.
      [ -x "$AGENT_DIR/bin/amazon-cloudwatch-agent-ctl" ] || exit 0

      # Already watching it: the healthy path, and deliberately the cheap one.
      if grep -lsq "$WATCHED" "$CONFIG_D"/*.json 2>/dev/null; then
          exit 0
      fi

      ENV_NAME=$(/opt/elasticbeanstalk/bin/get-config container \
                     -k environment_name 2>/dev/null)
      if [ -z "$ENV_NAME" ]; then
          # Better to leave logging broken and let the ingestion alarm fire than
          # to invent a log group name that no alarm or saved query looks at.
          log "cannot determine environment_name; not touching the agent config"
          exit 1
      fi

      cat > "$MARKER" <<JSON
      {
        "logs": {
          "logs_collected": {
            "files": {
              "collect_list": [
                {
                  "file_path": "$WATCHED",
                  "log_group_name": "/aws/elasticbeanstalk/$ENV_NAME$WATCHED",
                  "log_stream_name": "{instance_id}",
                  "timezone": "UTC"
                }
              ]
            }
          }
        }
      }
      JSON

      # append-config merges into whatever is already there and restarts the
      # agent; fetch-config would replace the directory and is what breaks this
      # in the first place.
      if "$AGENT_DIR/bin/amazon-cloudwatch-agent-ctl" \
             -a append-config -m ec2 -c "file:$MARKER" -s >/dev/null 2>&1; then
          log "re-asserted web.stdout.log streaming for $ENV_NAME"
      else
          log "append-config FAILED for $ENV_NAME; ingestion alarm should fire"
          exit 1
      fi

  "/etc/systemd/system/ngs360-ensure-logging.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Ensure web.stdout.log is streaming to CloudWatch
      After=amazon-cloudwatch-agent.service

      [Service]
      Type=oneshot
      ExecStart=/opt/ngs360/ensure-web-stdout-logging.sh

  "/etc/systemd/system/ngs360-ensure-logging.timer":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Periodically ensure web.stdout.log is streaming to CloudWatch

      [Timer]
      # Every minute, so a regeneration costs at most a minute of log data
      # rather than the 17 to 108 hours it has cost so far. The healthy path is
      # a single grep.
      OnBootSec=2min
      OnUnitActiveSec=1min
      AccuracySec=15s

      [Install]
      WantedBy=timers.target

commands:
  01_enable_ensure_logging_timer:
    command: |
      systemctl daemon-reload
      systemctl enable --now ngs360-ensure-logging.timer
      # Run once immediately rather than waiting for OnBootSec: a deploy is one
      # of the moments the config gets regenerated.
      /opt/ngs360/ensure-web-stdout-logging.sh || true
