# Run Alembic migrations during deployment.
#
# leader_only: true ensures this runs on exactly ONE instance per deploy, not on
# every instance -- concurrent "ALTER TABLE" from multiple instances would race.
#
# container_commands run from the staging dir (/var/app/staging, where
# alembic.ini lives) after requirements are installed into the platform venv but
# before the app is promoted to /var/app/current.
#
# A failing migration fails the deploy: the instance is not promoted, so old code
# never runs against a half-migrated schema. Migrations must therefore stay
# backward-compatible with the previous app version (additive columns, no
# NOT NULL on existing tables, constraints deferred a release), because the
# leader migrates before the remaining instances are updated.
container_commands:
  01_db_migrate:
    # Note: no `set -u`. Elastic Beanstalk environment property values are
    # arbitrary user data, and nounset turns any surprise into a failed deploy.
    command: |
      set -eo pipefail

      echo "=== 01_db_migrate: start (cwd=$(pwd)) ==="

      # ---------------------------------------------------------------------
      # 1. Load Elastic Beanstalk application environment properties.
      #
      # Alembic needs ENV_SECRETS and AWS_REGION to resolve
      # SQLALCHEMY_DATABASE_URI via Secrets Manager, and on Amazon Linux 2023
      # these are not in the shell by default.
      #
      # Do NOT `source` this file. It is a plain KEY=VALUE list, not a shell
      # script -- values are unquoted and may contain spaces. Sourcing it
      # executes them: a property whose value was "Bristol-Myers Squibb" made
      # bash read the line as the assignment KEY=Bristol-Myers followed by the
      # command `Squibb`, which exited 127 and aborted the deploy on
      # 2026-08-04. A value containing $(...) or backticks would likewise be
      # executed. Parse it instead, without evaluation.
      # ---------------------------------------------------------------------
      ENV_FILE=/opt/elasticbeanstalk/deployment/env
      if [ ! -r "$ENV_FILE" ]; then
        echo "ERROR: $ENV_FILE is not readable"
        ls -la "$(dirname "$ENV_FILE")" || true
        exit 1
      fi

      loaded=0
      while IFS='=' read -r key value || [ -n "$key" ]; do
        # Skip blanks, comments, and anything that is not a valid shell name.
        case "$key" in
          ''|'#'*)        continue ;;
          *[!A-Za-z0-9_]*) echo "  skipping malformed key: $key"; continue ;;
        esac
        export "$key=${value%$'\r'}"
        loaded=$((loaded + 1))
      done < "$ENV_FILE"
      echo "loaded $loaded environment properties from $ENV_FILE"

      # ---------------------------------------------------------------------
      # 2. Locate the platform virtualenv (not on PATH at this point).
      #
      # Deliberately not `ls -d /var/app/venv/*/ | head -n 1`: under
      # `set -o pipefail`, head closing the pipe can kill ls with SIGPIPE and
      # abort the command, and taking the first match can select a stale venv
      # left behind by an earlier deploy. Pick the newest one that actually
      # contains alembic.
      # ---------------------------------------------------------------------
      VENV=""
      for d in /var/app/venv/*/; do
        [ -x "${d}bin/alembic" ] || continue
        if [ -z "$VENV" ] || [ "$d" -nt "$VENV" ]; then
          VENV="$d"
        fi
      done
      if [ -z "$VENV" ]; then
        echo "ERROR: no virtualenv under /var/app/venv/ contains bin/alembic"
        ls -la /var/app/venv/ 2>/dev/null || echo "  /var/app/venv/ does not exist"
        exit 1
      fi
      echo "using venv: $VENV"

      # ---------------------------------------------------------------------
      # 3. Migrate. alembic.ini must be in the working directory.
      # ---------------------------------------------------------------------
      if [ ! -f alembic.ini ]; then
        echo "ERROR: alembic.ini not found in $(pwd)"
        ls -la
        exit 1
      fi

      echo "--- revision before upgrade ---"
      "${VENV}bin/alembic" current
      echo "--- upgrade head ---"
      "${VENV}bin/alembic" upgrade head
      echo "--- revision after upgrade ---"
      "${VENV}bin/alembic" current

      echo "=== 01_db_migrate: done ==="
    leader_only: true
