# Run Alembic migrations during deployment.
#
# leader_only: true ensures this runs on exactly ONE instance per deploy, not on
# every instance -- concurrent "ALTER TABLE" from multiple instances would race.
#
# container_commands run from the staging dir (/var/app/staging, where
# alembic.ini lives) after requirements are installed into the platform venv but
# before the app is promoted to /var/app/current.
#
# Two Amazon Linux 2023 details:
#   * Application environment properties (e.g. ENV_SECRETS, AWS_REGION) are not
#     in the shell by default, so we source the deployment env file. Alembic
#     needs these to resolve SQLALCHEMY_DATABASE_URI (via AWS Secrets Manager).
#   * The platform venv is not on PATH here, so we invoke its alembic by path.
container_commands:
  01_db_migrate:
    command: |
      set -euo pipefail
      set -a
      . /opt/elasticbeanstalk/deployment/env
      set +a
      VENV=$(ls -d /var/app/venv/*/ | head -n 1)
      "${VENV}bin/alembic" upgrade head
    leader_only: true
